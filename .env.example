# ===========================================
# TwinMe - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values. NEVER commit .env.
# Written by scripts/env-example.mjs from what api/ and src/ read (M3-4, 2026-09-19);
# run `node scripts/env-example.mjs` after adding a key. Notes above a key are kept.
#
# Do NOT set NODE_ENV here: Vite reads .env during `vite build`, and
# NODE_ENV=development ships development React (StrictMode double effects, no
# dead-code elimination). The dev server gets it from nodemon.json instead.

# --- Core: the server refuses to start without these ---
# read by mcp-server/src/utils/service-adapters.ts, routes/entertainment-connectors.js and 1 more
ENCRYPTION_KEY=generate-a-strong-random-string-min-32-chars
# read by middleware/auth.js, routes/analytics.js and 7 more
JWT_SECRET=generate-a-strong-random-string-min-32-chars
# read by services/embeddingService.js, services/enrichment/braveSearchProvider.js and 5 more
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
# read by config/supabase.js, cron/platform-polling.js and 15 more
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Supabase ---
# read by config/supabase.js
SUPABASE_ANON_KEY=your-anon-key
# read by config/supabase.js, cron/platform-polling.js and 16 more
SUPABASE_URL=https://your-project.supabase.co
# read by src/integrations/supabase/client.ts, src/lib/supabase.ts
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Auth, sessions and cookies ---
# read by middleware/validateOAuthCredentials.js, routes/auth-simple.js and 4 more
# APP_URL=
# read by routes/auth-simple.js
# COOKIE_DOMAIN=
# read by routes/auth-simple.js, routes/connectors.js and 4 more
GOOGLE_CLIENT_SECRET=your-google-client-secret
# read by services/messagingChannelOtpService.js
# OTP_HMAC_SECRET=
# Resend email
RESEND_API_KEY=re_your-resend-api-key
# read by routes/oauth-callback.js
# TOKEN_ENCRYPTION_KEY=
# read by mcp-server/src/auth/api-key-auth.ts
# TWINME_API_KEY=
# read by middleware/validateOAuthCredentials.js, routes/auth-simple.js and 5 more
VITE_APP_URL=http://localhost:8086
# Chrome Extension ID used to sync auth tokens from OAuthCallback
VITE_CHROME_EXTENSION_ID=acnofcjjfjaikcfnalggkkbghjaijepc

# --- Money: the product ---
# read by services/money/feeds/enableBanking.js
# ENABLE_BANKING_APP_ID=
# read by services/money/feeds/enableBanking.js
# ENABLE_BANKING_BASE_URL=
# read by services/money/feeds/enableBanking.js
# ENABLE_BANKING_PRIVATE_KEY=
# read by services/money/feeds/enableBanking.js
# ENABLE_BANKING_REDIRECT_URL=
# read by services/money/home.js
# GOOGLE_PLACES_API_KEY=
# read by services/money/betaCapabilities.js
# MONEY_ADVANCED_BETA_USER_IDS=
# read by services/money/chat.js
# MONEY_CHAT_REASONING=
# read by services/money/chat.js
# MONEY_CHAT_REASONING_PATIENCE_MS=
# read by services/money/currency.js
# MONEY_CURRENCY=
# read by services/money/inbox.js
MONEY_INBOX_DOMAIN=in.twinme.me
# read by services/money/zone.js
# MONEY_TZ=
# Receipts inbox: Resend receives mail for MONEY_INBOX_DOMAIN and posts to /api/money/inbox/resend.
# The secret is the receiving webhook's signing secret (whsec_...).
RESEND_WEBHOOK_SECRET=

# --- Language models ---
# read by services/twinChatPersistence.js
# CHAT_PERSIST_BUDGET_MS=
# read by config/aiModels.js
# FINETUNED_TWIN_MODEL=
# read by middleware/legacyTwin.js
# LEGACY_TWIN_ENABLED=
# Optional: daily budget cap in USD (default: 10)
# LLM_DAILY_BUDGET_USD=10
# read by services/llmBudgetGuard.js
# LLM_DAILY_HARD_LIMIT_USD=
# read by services/llmBudgetGuard.js
# LLM_PER_INSTANCE_MAX_CALLS=
# read by services/llmGateway.js
# LLM_STREAM_TIMEOUT_MS=
# read by services/llmGateway.js
# PER_USER_DAILY_BUDGET_USD=
# read by routes/whatsapp-twinme-webhook.js, services/transactions/transactionNudgeService.js and 2 more
# PURCHASE_BOT_ENABLED=
# read by routes/whatsapp-twinme-webhook.js
# PURCHASE_RATE_LIMIT_PER_HOUR=
# read by routes/whatsapp-twinme-webhook.js, services/whatsappService.js
# TWINME_WHATSAPP_PHONE_NUMBER_ID=
# read by routes/whatsapp-twinme-webhook.js
# TWINME_WHATSAPP_VERIFY_TOKEN=
# read by routes/whatsapp-twinme-webhook.js, services/whatsappService.js
# TWINME_WHATSAPP_WEBHOOK_SECRET=

# --- Platform connections (OAuth) ---
# read by routes/connectors.js, services/webhookReceiverService.js
# API_URL=
# read by services/nangoService.js
# DEV_USER_ID=
# read by routes/additional-entertainment-connectors.js, routes/connectors.js and 4 more
# DISCORD_CLIENT_ID=
# read by routes/connectors.js, routes/entertainment-connectors.js and 3 more
# DISCORD_CLIENT_SECRET=
# read by routes/additional-entertainment-connectors.js, routes/connectors.js and 4 more
# GITHUB_CLIENT_ID=
# read by routes/connectors.js, routes/entertainment-connectors.js and 2 more
# GITHUB_CLIENT_SECRET=
# Google (Calendar + YouTube)
GOOGLE_CLIENT_ID=your-google-client-id
# read by config/googleWorkspaceScopes.js, services/scopeEscalationService.js
# GOOGLE_WORKSPACE_FULL_SCOPES=
# read by routes/additional-entertainment-connectors.js
# INSTAGRAM_CLIENT_ID=
# read by routes/additional-entertainment-connectors.js
# MEDIUM_CLIENT_ID=
# read by routes/nango.js, services/nangoService.js
# NANGO_SECRET_KEY=
# read by routes/nango-webhooks.js, routes/nango.js
# NANGO_WEBHOOK_SECRET=
# The dev server gets NODE_ENV=development from nodemon.json instead.
PORT=3004
# Optional. Spotify restricted /v1/audio-features (Nov 2024) and it returns 403
# for this app, so all six call sites are gated off by default. Set to exactly
# "true" only if access is restored — see api/services/spotify/audioFeatures.js.
# SPOTIFY_AUDIO_FEATURES_ENABLED=true
# Spotify
SPOTIFY_CLIENT_ID=your-spotify-client-id
# read by routes/connectors.js, routes/entertainment-connectors.js and 5 more
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
# read by routes/additional-entertainment-connectors.js
# TWITTER_CLIENT_ID=
# Whoop
WHOOP_CLIENT_ID=your-whoop-client-id
# read by routes/connectors.js, services/oauthRevocation.js and 1 more
WHOOP_CLIENT_SECRET=your-whoop-client-secret

# --- Messaging (WhatsApp, Telegram, voice) ---
# read by routes/voice-bridge.js
# BRIDGE_BASE_URL=
# read by routes/voice-bridge.js
# BRIDGE_SHARED_SECRET=
# Presence (family-relay voice companion; plan .claude/plans/2026-09-15-presence-forward).
# ELEVENLABS_API_KEY: with it the agent is private (sessions start with a server-issued
# token) and /complete reads the transcript ElevenLabs holds; without it, local-dev
# mode: public agent id and the browser's transcript.
ELEVENLABS_API_KEY=
# The ElevenLabs agent that answers her calls. Configure it from the repo:
#   node scripts/presence/configure-agent.mjs --apply
ELEVENLABS_PRESENCE_AGENT_ID=
# read by routes/cron-presence-calls.js
ELEVENLABS_PRESENCE_PHONE_NUMBER_ID=
# Her calling number, imported into ElevenLabs (scripts/presence/import-number.mjs prints the id).
# Provider: sip_trunk (default; any Brazilian number an individual with a CPF can buy) or twilio
# (Twilio's +55 numbers need a CNPJ). For sip_trunk the script also needs PRESENCE_SIP_ADDRESS,
# PRESENCE_SIP_USERNAME and PRESENCE_SIP_PASSWORD; for twilio, TWILIO_ACCOUNT_SID/AUTH_TOKEN.
ELEVENLABS_PRESENCE_PHONE_PROVIDER=sip_trunk
# read by routes/life-story-voice.js, routes/onboarding-voice.js and 1 more
ELEVENLABS_WEBHOOK_SECRET=
# read by services/whatsappService.js
# EVOLUTION_API_KEY=
# read by services/whatsappService.js
# EVOLUTION_API_URL=
# read by routes/whatsapp-evolution-webhook.js, services/whatsappService.js
# EVOLUTION_INSTANCE=
# read by routes/whatsapp-evolution-webhook.js
# EVOLUTION_WEBHOOK_SECRET=
# read by services/whatsappService.js
# KAPSO_API_KEY=
# read by services/whatsappService.js
# KAPSO_PHONE_NUMBER_ID=
# read by routes/whatsapp-kapso-webhook.js
# KAPSO_WEBHOOK_SECRET=
# read by routes/voice-bridge.js, services/embeddingService.js and 3 more
# OPENAI_API_KEY=
# read by routes/cron-presence-calls.js
PRESENCE_CALLS_ENABLED=false
# Voice cloning spends real money; off, /voice-samples answers 503.
PRESENCE_VOICE_CLONE_ENABLED=false
# read by services/voiceProvider.js
# PRESENCE_VOICE_PROVIDER=
# read by routes/voice-bridge.js
# SELF_API_BASE_URL=
# read by services/telegramService.js
# TELEGRAM_BOT_TOKEN=
# read by routes/telegram-link.js
# TELEGRAM_BOT_USERNAME=
# read by routes/telegram-webhook.js
# TELEGRAM_WEBHOOK_SECRET=
# read by services/whatsappService.js
# TWINME_DISABLE_OUTBOUND_SEND=
# read by services/whatsappService.js
# TWINME_WHATSAPP_ACCESS_TOKEN=
# read by routes/webhook-vapi.js
# VAPI_WEBHOOK_SECRET=
# read by routes/voice-bridge.js
# WAHA_API_KEY=
# read by routes/voice-bridge.js
# WAHA_BASE_URL=
# read by services/whatsappService.js
# ZAPI_CLIENT_TOKEN=
# read by routes/whatsapp-zapi-webhook.js, services/whatsappService.js
# ZAPI_INSTANCE_ID=
# read by services/whatsappService.js
# ZAPI_INSTANCE_TOKEN=
# read by routes/whatsapp-zapi-webhook.js
# ZAPI_WEBHOOK_SECRET=

