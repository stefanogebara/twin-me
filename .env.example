# read by routes/webhooks.js
# GMAIL_PUBSUB_AUDIENCE=
# read by services/webhookReceiverService.js
# GOOGLE_PROJECT_ID=
# read by mcp-server/src/http-server.ts
# MCP_HTTP_PORT=
# Optional: Mistral OCR — the "papers / dense multi-page PDF" extraction tier.
# Digital PDFs use the unpdf text layer and images use the OpenRouter vision
# model with NO extra key; this key only unlocks OCR of scanned PDFs (Mistral's
# dedicated OCR endpoint, ~$1/1000 pages — NOT available via OpenRouter).
# Without it, scanned PDFs return { needsOcr: true }.
# MISTRAL_API_KEY=your-mistral-api-key
# read by routes/og-image.js
# OG_CARD_RATE_LIMIT_MAX=
# read by services/inngestSelfHeal.js
# PUBLIC_APP_URL=
# read by server.js
# RATE_LIMIT_MAX_REQUESTS=
# read by server.js
# RATE_LIMIT_WINDOW_MS=
# Redis — cache, chat rate limiting, queues. Works without it: falls back to
# an in-memory, per-instance cache (fine for local dev; NOT shared across
# serverless instances, so set it in production). UPSTASH_REDIS_URL is
# accepted as an alias where supported (redisClient, queueService).
# REDIS_URL=redis://localhost:6379
# read by services/emailService.js
RESEND_FROM_EMAIL=twin@twinme.me
# read by server.js
# SENTRY_DSN=
# read by services/finetuning/personalityOracle.js
# TOGETHER_API_KEY=
# read by server.js, services/queueService.js and 1 more
# UPSTASH_REDIS_URL=
# read by config/requestTimeouts.js, dev-start.js and 1 more
# USE_CURL_FETCH=
# read by services/callService.js
# VAPI_API_KEY=
# read by services/callService.js
# VAPI_PHONE_NUMBER_ID=
# read by routes/soul-extraction.js, src/services/api/apiBase.ts
VITE_API_URL=http://localhost:3004/api
# read by middleware/platformValidation.js, middleware/privacyFilter.js and 5 more
VITE_SUPABASE_URL=https://your-project.supabase.co
