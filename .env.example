# read by config/financialThresholds.js
# DEFAULT_CURRENCY=
# read by server.js
# DISABLE_BACKGROUND_JOBS=
# Post-call webhook secret (ElevenLabs agent settings > Webhooks, HMAC), and the shared
# secret ElevenLabs sends as x-presence-secret on the conversation-initiation webhook.
ELEVENLABS_POST_CALL_SECRET=
# read by routes/desktop-download.js, services/enrichment/quickEnrichment.js and 1 more
# GITHUB_TOKEN=
# read by routes/webhooks.js, services/webhookReceiverService.js
